generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Model Karyawan (Pengganti User untuk Staff)
model Karyawan {
  id             String   @id @default(uuid()) @map("id_karyawan")
  email          String   @unique @map("email")
  fullName       String   @map("nama_lengkap")
  password       String   @map("kata_sandi")
  remainingLeave Int      @default(12) @map("sisa_cuti")
  createdAt      DateTime @default(now()) @map("dibuat_pada")

  // Relasi
  departmentId String?     @map("id_departemen")
  department   Department? @relation(fields: [departmentId], references: [id])

  leaveRequests LeaveRequest[]

  // Kita hardcode role di logika aplikasi sebagai 'EMPLOYEE'
  @@map("Karyawan")
}

// 2. Model HRD (Tabel Baru Khusus Admin)
model HRD {
  id        String   @id @default(uuid()) @map("id_hrd")
  email     String   @unique @map("email")
  fullName  String   @map("nama_lengkap")
  password  String   @map("kata_sandi")
  
  // Relasi: HRD yang memberikan persetujuan
  approvals LeaveApproval[]

  // Kita hardcode role di logika aplikasi sebagai 'HRD'
  @@map("HRD")
}

// 3. Model Departemen
model Department {
  id                 String @id @default(uuid()) @map("id_departemen")
  name               String @unique @map("nama")
  maxConcurrentLeave Int    @default(2) @map("maks_cuti_bersamaan")

  karyawans     Karyawan[] // Relasi ke Karyawan
  leaveRequests LeaveRequest[]

  @@map("Departemen")
}

// 4. Model Permintaan Cuti
model LeaveRequest {
  id           String      @id @default(uuid()) @map("id_permintaan_cuti")
  
  // Relasi Karyawan (Yang mengajukan)
  employeeId   String      @map("id_karyawan")
  employee     Karyawan    @relation(fields: [employeeId], references: [id])

  // Relasi Departemen
  departmentId String?     @map("id_departemen")
  department   Department? @relation(fields: [departmentId], references: [id])

  leaveType    LeaveType   @map("jenis_cuti")
  status       LeaveStatus @default(PENDING) @map("status")
  startDate    DateTime    @map("tanggal_mulai")
  endDate      DateTime    @map("tanggal_akhir")
  reason       String      @map("alasan")
  daysTaken    Int         @map("durasi_hari")
  proofUrl     String?     @map("url_bukti")
  
  approval     LeaveApproval?

  createdAt    DateTime    @default(now()) @map("dibuat_pada")
  updatedAt    DateTime    @updatedAt @map("diperbarui_pada")

  @@map("Permintaan_Cuti")
}

// 5. Model Persetujuan Cuti
model LeaveApproval {
  id                String   @id @default(uuid()) @map("id_persetujuan_cuti")
  
  leaveRequestId    String   @unique @map("id_permintaan_cuti")
  leaveRequest      LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  // Relasi ke HRD (Bukan User lagi)
  hrdId             String   @map("id_hrd")
  hrd               HRD      @relation(fields: [hrdId], references: [id])

  approvalDate      DateTime @default(now()) @map("tanggal_persetujuan")
  finalStatus       LeaveStatus @map("status_final")
  comment           String?  @map("keterangan")

  @@map("Persetujuan_Cuti")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
}

// UserRole hanya untuk keperluan TypeScript di Auth, tidak perlu di DB jika tabel pisah
enum UserRole {
  EMPLOYEE
  HRD
}