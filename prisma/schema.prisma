generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Karyawan {
  id             String         @id @default(uuid())
  email          String         @unique
  fullName       String
  password       String
  remainingLeave Int            @default(12)
  createdAt      DateTime       @default(now())
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  leaveRequests  LeaveRequest[]

  @@map("Karyawan")
}

model HRD {
  id        String          @id @default(uuid())
  email     String          @unique
  fullName  String
  password  String
  approvals LeaveApproval[]

  @@map("HRD")
}

model Department {
  id                 String         @id @default(uuid())
  name               String         @unique
  maxConcurrentLeave Int            @default(2)
  karyawans          Karyawan[]
  leaveRequests      LeaveRequest[]

  @@map("Departemen")
}

model LeaveRequest {
  id           String         @id @default(uuid())
  employeeId   String
  employee     Karyawan       @relation(fields: [employeeId], references: [id])
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  leaveType    LeaveType
  status       LeaveStatus    @default(PENDING)
  startDate    DateTime
  endDate      DateTime
  reason       String
  daysTaken    Int
  proofUrl     String?
  approval     LeaveApproval?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("Permintaan_Cuti")
}

model LeaveApproval {
  id             String       @id @default(uuid())
  leaveRequestId String       @unique
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  hrdId          String
  hrd            HRD          @relation(fields: [hrdId], references: [id])
  approvalDate   DateTime     @default(now())
  finalStatus    LeaveStatus
  comment        String?

  @@map("Persetujuan_Cuti")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
}